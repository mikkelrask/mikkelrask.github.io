---
interface Props {
  size: "sm" | "md" | "bg";
}

const { size } = Astro.props;

const sizes = {
  sm: "18px",
  md: "22px",
  bg: "28px",
};
---

<h1 class="title-wrapper" style={`font-size: ${sizes[size]}`}>
  <slot />
</h1>

<style>
  .title-wrapper {
    margin-bottom: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    word-break: none;
  }

  .title-wrapper :global(a) {
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .title-wrapper :global(a:hover) {
    color: var(--secondaryText);
  }
</style>
