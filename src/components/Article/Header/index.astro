---
import { author } from "../../../blog-config.js";
import Divider from "../../../components/Divider/index.astro";

interface Props {
  title: string;
  date: Date | string;
}
const { title, date } = Astro.props;

// getDay() is Sunday-first — Danish week starts Monday.
const WEEKDAYS = ["Søn", "Man", "Tirs", "Ons", "Tors", "Fre", "Lør"];
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "Maj", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dec"];

function formatEmailDate(d: Date): string {
  return `${WEEKDAYS[d.getDay()]}, ${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
}

const emailDate = date instanceof Date ? formatEmailDate(date) : String(date);
---

<div class="email-header">
  <h1 class="sr-only">{title}</h1>
  <div class="email-line">
    <span class="email-label">Date:</span>
    <span class="email-value">{emailDate}</span>
  </div>
  <div class="email-line">
    <span class="email-label">From:</span>
    <span class="email-value">{author} &lt;mr@github&gt;</span>
  </div>
  <div class="email-line">
    <span class="email-label">To:</span>
    <span class="email-value">You</span>
  </div>
  <div class="email-line">
    <span class="email-label">Subject:</span>
    <span class="email-value">{title}</span>
  </div>
  <Divider mt="24px" mb="40px" />
</div>

<style>
  .email-header {
    margin-top: 32px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "HackNFM", monospace;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text);
  }
  @media (max-width: 768px) {
    .email-header {
      padding: 0 15px;
    }
  }
  .email-line {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 16px;
  }
  .email-label {
    color: var(--secondaryText);
  }
  .email-value {
    overflow-wrap: anywhere;
  }
  /* Visually hidden h1 — keeps heading structure for SEO/AT without a big title */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
