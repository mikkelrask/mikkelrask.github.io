---
import AppWindow from "../AppWindow/index.astro";

interface Props {
  workerUrl: string;
}

const { workerUrl } = Astro.props;
---

<AppWindow title="now-playing.py" id="np-window" style="visibility:hidden;">
  <Fragment slot="buttons">
    <button class="app-btn app-btn-close" id="np-btn-close" title="hide"
    ></button>
    <button class="app-btn app-btn-min" id="np-btn-min" title="expand"></button>
  </Fragment>

  <!-- collapsed bar (default) -->
  <div class="np-collapsed" id="np-collapsed">
    <div class="np-bars">
      <div class="np-bar"></div>
      <div class="np-bar"></div>
      <div class="np-bar"></div>
    </div>
    <span class="np-mini-track" id="np-mini-track"></span>
    <span class="np-mini-artist" id="np-mini-artist"></span>
  </div>

  <!-- expanded body (hidden by default) -->
  <div class="np-body" id="np-body" style="display:none">
    <div class="np-vinyl-wrap">
      <svg
        class="np-vinyl-svg"
        viewBox="0 0 140 140"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <clipPath id="np-clip">
            <circle cx="70" cy="70" r="68"></circle>
          </clipPath>
        </defs>
        <circle cx="70" cy="70" r="68" fill="#1a1a1a"></circle>
        <image
          id="np-vinyl-art"
          href=""
          width="140"
          height="140"
          clip-path="url(#np-clip)"
          opacity="0.85"
        />
        <circle
          cx="70"
          cy="70"
          r="65"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle
          cx="70"
          cy="70"
          r="60"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle
          cx="70"
          cy="70"
          r="55"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle
          cx="70"
          cy="70"
          r="50"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle
          cx="70"
          cy="70"
          r="45"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle
          cx="70"
          cy="70"
          r="40"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle cx="70" cy="70" r="34" fill="none" stroke="#33" stroke-width="1"
        ></circle>
        <circle
          cx="70"
          cy="70"
          r="28"
          fill="none"
          stroke="#2a2a2a"
          stroke-width="0.5"></circle>
        <circle cx="70" cy="70" r="22" fill="#222"></circle>
        <circle cx="70" cy="70" r="4" fill="#555"></circle>
        <circle cx="70" cy="70" r="2" fill="#888"></circle>
      </svg>
    </div>

    <div class="np-expanded-meta">
      <div class="np-status-row">
        <div class="np-bars">
          <div class="np-bar"></div>
          <div class="np-bar"></div>
          <div class="np-bar"></div>
        </div>
        <span class="np-status-text">now playing</span>
      </div>
      <a class="np-link" id="np-link" href="#" target="_blank">
        <div class="np-track-name" id="np-track"></div>
        <div class="np-artist-name" id="np-artist"></div>
      </a>
    </div>
  </div>
</AppWindow>

<script is:inline define:vars={{ workerUrl }}>
  const win = document.getElementById("np-window");
  const collapsed = document.getElementById("np-collapsed");
  const body = document.getElementById("np-body");
  const vinylArt = document.getElementById("np-vinyl-art");
  const npLink = document.getElementById("np-link");
  const npTrack = document.getElementById("np-track");
  const npArtist = document.getElementById("np-artist");
  const npMiniTrack = document.getElementById("np-mini-track");
  const npMiniArtist = document.getElementById("np-mini-artist");
  const btnClose = document.getElementById("np-btn-close");
  const btnMin = document.getElementById("np-btn-min");

  let isExpanded = false;
  let isHidden = false;

  btnMin.addEventListener("click", () => {
    isExpanded = !isExpanded;
    body.style.display = isExpanded ? "block" : "none";
    collapsed.style.display = isExpanded ? "none" : "flex";
  });

  btnClose.addEventListener("click", () => {
    isHidden = !isHidden;
    body.style.display = "none";
    collapsed.style.display = isHidden ? "none" : "flex";
    if (isHidden) isExpanded = false;
  });

  async function fetchNowPlaying() {
    try {
      const res = await fetch(`${workerUrl}/now-playing`);
      const data = await res.json();

      if (!data.currently_playing || !data.track) {
        win.style.visibility = "hidden";
        return;
      }

      const track = data.track;
      const artists =
        track.artists?.map((a) => a.name).join(", ") || "Ukendt artist";
      const songUrl = `https://mono.squid.wtf/search/${encodeURIComponent(track.title + " " + artists)}`;

      npTrack.textContent = track.title;
      npArtist.textContent = artists;
      npMiniTrack.textContent = track.title;
      npMiniArtist.textContent = artists;
      npLink.href = songUrl;

      vinylArt.setAttribute(
        "href",
        track.image ? `${workerUrl}/image/${track.image}` : "",
      );

      if (!isHidden) win.style.visibility = "visible";
    } catch (e) {
      console.error("now-playing fetch failed", e);
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);
</script>

<style is:global>
  @media (max-width: 768px) {
    #np-window {
      display: none !important;
    }
  }

  @keyframes np-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes np-bounce {
    from {
      height: 3px;
    }
    to {
      height: 11px;
    }
  }

  .np-vinyl-svg {
    width: 140px;
    height: 140px;
    display: block;
    animation: np-spin 6s linear infinite;
  }

  .np-bar {
    width: 3px;
    border-radius: 1px;
    animation: np-bounce 0.6s ease-in-out infinite alternate;
    height: 3px;
  }
  .np-bar:nth-child(2) {
    animation-delay: 0.15s;
  }
  .np-bar:nth-child(3) {
    animation-delay: 0.3s;
  }
</style>

<style>
  /* collapsed bar */
  .np-collapsed {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    height: 36px;
    background: var(--scrollTrack);
    overflow: hidden;
  }

  .np-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 11px;
    flex-shrink: 0;
  }

  .np-bars .np-bar {
    background: var(--fg);
  }

  .np-mini-track {
    font-size: 11px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  .np-mini-artist {
    font-size: 11px;
    color: var(--secondaryText);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* expanded body */
  .np-body {
    background: var(--bodyBackground);
    padding: 16px;
    text-align: center;
  }

  .np-vinyl-wrap {
    width: 140px;
    height: 140px;
    margin: 0 auto 14px;
  }

  .np-expanded-meta {
    max-width: 180px;
    margin: 0 auto;
  }

  .np-status-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-bottom: 8px;
  }

  .np-status-row .np-bars .np-bar {
    background: var(--secondaryText);
  }

  .np-status-text {
    font-size: 10px;
    color: var(--tertiaryText);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .np-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .np-link:hover .np-track-name {
    text-decoration: underline;
  }

  .np-track-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-artist-name {
    font-size: 11px;
    color: var(--secondaryText);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }
</style>
