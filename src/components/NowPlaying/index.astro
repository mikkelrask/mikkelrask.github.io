---
interface Props {
  workerUrl: string;
}

const { workerUrl } = Astro.props;
---

<div class="np-section">
  <div class="title">$ ./<span style="text-decoration:underline;">now-listening.sh</span></div>
  <div class="now-playing-wrapper" id="now-playing-wrapper">
    <div class="vinyl-wrap">
      <svg class="vinyl-svg" viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="circle-clip">
            <circle cx="90" cy="90" r="88"/>
          </clipPath>
        </defs>
        <circle cx="90" cy="90" r="88" fill="#1a1a1a"/>
        <image id="vinyl-art" href="" width="180" height="180" clip-path="url(#circle-clip)" opacity="0.55"/>
        <circle cx="90" cy="90" r="84" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="78" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="72" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="66" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="60" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="54" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="48" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="42" fill="none" stroke="#333" stroke-width="1"/>
        <circle cx="90" cy="90" r="36" fill="none" stroke="#2a2a2a" stroke-width="0.5"/>
        <circle cx="90" cy="90" r="30" fill="#222"/>
        <circle cx="90" cy="90" r="5" fill="#555"/>
        <circle cx="90" cy="90" r="2.5" fill="#888"/>
      </svg>
    </div>

    <div class="np-meta">
      <div class="np-status-row">
        <div class="np-bars">
          <div class="np-bar"></div>
          <div class="np-bar"></div>
          <div class="np-bar"></div>
        </div>
        <span class="np-status-text">now playing</span>
      </div>

      <a class="np-link" id="np-link" href="#" target="_blank">
        <div class="np-track-name" id="np-track"></div>
        <div class="np-artist-name" id="np-artist"></div>
      </a>

      <div class="np-progress">
        <div class="np-progress-bar">
          <div class="np-progress-fill" id="np-fill"></div>
        </div>
        <div class="np-progress-times">
          <span class="np-time" id="np-elapsed">0:00</span>
          <span class="np-time" id="np-duration">0:00</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ workerUrl }}>
  const wrapper    = document.getElementById('now-playing-wrapper');
  const vinylArt   = document.getElementById('vinyl-art');
  const npLink     = document.getElementById('np-link');
  const npTrack    = document.getElementById('np-track');
  const npArtist   = document.getElementById('np-artist');
  const npFill     = document.getElementById('np-fill');
  const npElapsed  = document.getElementById('np-elapsed');
  const npDuration = document.getElementById('np-duration');

  let tickInterval = null;
  let elapsed = 600;
  let duration = 0;

  function fmt(secs) {
    const s = Math.floor(secs);
    return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  }

  function startTicker() {
    clearInterval(tickInterval);
    tickInterval = setInterval(() => {
      if (elapsed < duration) {
        elapsed += 1;
        npElapsed.textContent = fmt(elapsed);
        npFill.style.width = Math.min(100, Math.round((elapsed / duration) * 100)) + '%';
      }
    }, 1000);
  }

  async function fetchNowPlaying() {
    try {
      const res  = await fetch(`${workerUrl}/now-playing`);
      const data = await res.json();

      if (!data.currently_playing || !data.track) {
        wrapper.style.visibility = 'hidden';
        clearInterval(tickInterval);
        return;
      }

      const track   = data.track;
      const artists = track.artists?.map(a => a.name).join(', ') || 'Ukendt artist';
      const songUrl = `https://mono.squid.wtf/search/${encodeURIComponent(track.title + ' ' + artists)}`;

      npTrack.textContent  = track.title;
      npArtist.textContent = artists;
      npLink.href          = songUrl;

      duration = track.duration || 0;
      elapsed  = 0;
      npDuration.textContent = fmt(duration);
      npElapsed.textContent  = fmt(elapsed);
      npFill.style.width = '0%';
      startTicker();

      vinylArt.setAttribute('href', track.image
        ? `${workerUrl}/image/${track.image}`
        : ''
      );

      wrapper.style.visibility = 'visible';
    } catch (e) {
      console.error('now-playing fetch failed', e);
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);
</script>

<style is:global>
  @keyframes np-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes np-bounce {
    from { height: 3px; }
    to   { height: 12px; }
  }

  .vinyl-svg {
    width: 180px;
    height: 180px;
    display: block;
    animation: np-spin 7s linear infinite;
  }

  .np-bar {
    width: 3px;
    background: var(--secondaryText);
    border-radius: 1px;
    animation: np-bounce 0.6s ease-in-out infinite alternate;
  }
  .np-bar:nth-child(2) { animation-delay: 0.15s; }
  .np-bar:nth-child(3) { animation-delay: 0.30s; }
</style>

<style>
  .np-section {
    margin: 32px 0 0;
  }

  .title {
    font-weight: bold;
    margin-bottom: 16px;
  }

  .now-playing-wrapper {
    visibility: hidden;
    display: none;
    text-align: center;
  }

  @media (min-width: 769px) {
    .now-playing-wrapper {
      display: block;
    }
  }

  .vinyl-wrap {
    width: 180px;
    height: 180px;
    margin: 0 auto 24px;
  }

  .np-meta {
    max-width: 90%;
    margin: 0 auto;
  }

  .np-status-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .np-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .np-status-text {
    font-size: 11px;
    color: var(--tertiaryText);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .np-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .np-link:hover .np-track-name {
    text-decoration: underline;
  }

  .np-track-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-artist-name {
    font-size: 12px;
    color: var(--secondaryText);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
    text-transform:uppercase;
  }

  .np-progress {
    margin-top: 12px;
  }

  .np-progress-bar {
    height: 2px;
    background: var(--border, #e0e0e0);
    border-radius: 1px;
    overflow: hidden;
  }

  .np-progress-fill {
    height: 100%;
    background: var(--secondaryText);
    border-radius: 1px;
    transition: width 1s linear;
    width: 0%;
  }

  .np-progress-times {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
  }

  .np-time {
    font-size: 10px;
    color: var(--tertiaryText);
    font-variant-numeric: tabular-nums;
  }
</style>
