---
import AppWindow from "../AppWindow/index.astro";

interface Props {
  categories: { fieldValue: string; totalCount: number }[];
}

const { categories } = Astro.props;
---

<aside class="wrapper">
  <AppWindow title="tree categories/">
    <div class="app-body tree-output">
      <div class="tree-root">categories/</div>
      {
        categories.map((category, index) => {
          const isLast = index === categories.length - 1;
          const prefix = isLast ? "└── " : "├── ";
          return (
            <div class="tree-node">
              <span class="tree-prefix">{prefix}</span>
              <a href={`/categories?q=${category.fieldValue}`}>
                {category.fieldValue}
                <span class="category-count">({category.totalCount})</span>
              </a>
            </div>
          );
        })
      }
    </div>
  </AppWindow>
</aside>

<style>
  .wrapper {
    position: sticky;
    top: 0;
    width: 280px;
    height: auto;
    font-size: 16px;
  }

  @media (max-width: 1079px) {
    .wrapper {
      display: none;
    }
  }

  .tree-output {
    padding: 16px;
    font-family: 'HackNFM', monospace);
    font-size: 14px;
    color: var(--text);
    line-height: 1.6;
  }

  .tree-root {
    color: var(--tertiaryText);
    font-weight: bold;
    margin-bottom: 4px;
  }

  .tree-node {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }

  .tree-prefix {
    color: var(--tertiaryText);
  }

  .tree-node a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .tree-node a:hover {
    color: var(--hoveredLinkText);
    text-decoration: none;
  }

  .category-count {
    color: var(--tertiaryText);
    margin-left: 8px;
    font-size: 12px;
  }
</style>
