---
import { FaLinux, FaApple, FaWindows, FaDesktop } from "react-icons/fa";

interface Props {
  packageList: any[];
}

const { packageList } = Astro.props;

const osIcon = (entry: string) => {
  const key = entry.toLowerCase();
  if (key.includes("linux")) return FaLinux;
  if (key.includes("mac") || key.includes("darwin") || key.includes("osx")) return FaApple;
  if (key.includes("win")) return FaWindows;
  return FaDesktop;
};
---

<div class="package-grid">
  {packageList.map((pkg, i) => {
    const { title, description, image, date, type, language, os = [] } = pkg.frontmatter;
    const { slug } = pkg.fields;

    return (
      <div class="package-item" data-type={type}>
        <a href={slug} class="card-link">
          {image && (
            <div class="card-image">
              <img src={image.src} alt={title} loading={i === 0 ? "eager" : "lazy"} />
            </div>
          )}
          <div class="card-content">
            <div class="card-heading">
              <h2>{title}</h2>
              {os.length > 0 && (
                <div class="card-os-icons">
                  {os.map((entry: string) => {
                    const Icon = osIcon(entry);
                    return (
                      <span class="os-icon" title={entry}>
                        <Icon />
                      </span>
                    );
                  })}
                </div>
              )}
            </div>
            {description && (
              <p class="card-description">{description}</p>
            )}
            <div class="card-meta">
              {type && <span class="badge type-badge">{type}</span>}
              {language && <span class="badge language-badge">{language}</span>}
              <span class="card-date">{date}</span>
            </div>
          </div>
        </a>
      </div>
    );
  })}
</div>

<style>
  .package-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }

  @media (max-width: 768px) {
    .package-grid {
      grid-template-columns: 1fr;
      padding: 0 5px;
    }
  }

  .package-item {
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--cardBackground, var(--divider));
    transition: transform 0.2s ease-in-out, box-shadow 0.3s;
  }

  @media (min-width: 769px) {
    .package-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--divider);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  @media (min-width: 769px) {
    .package-item:hover .card-image img {
      transform: scale(1.05);
    }
  }

  .card-content {
    padding: 20px;
  }

  .card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-heading h2 {
    font-size: 20px;
    color: var(--text);
  }

  .card-os-icons {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .os-icon {
    display: inline-flex;
    color: var(--tertiaryText);
  }

  .os-icon :global(svg) {
    width: 13px;
    height: 13px;
  }

  .card-description {
    margin-bottom: 12px;
    font-size: 15.2px;
    color: var(--secondaryText);
    line-height: 1.6;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card-date {
    margin-left: auto;
    font-size: 12.8px;
    color: var(--tertiaryText);
  }

  .badge {
    padding: 2px 10px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    font-family: "HackNFM", monospace;
  }

  .type-badge {
    background-color: var(--typeBadgeBackground);
    color: var(--typeBadgeText);
  }

  .language-badge {
    background-color: var(--languageBadgeBackground);
    color: var(--languageBadgeText);
  }

  @media (max-width: 768px) {
    .package-grid {
      gap: 16px;
    }

    .card-content {
      padding: 16px;
    }
  }
</style>
