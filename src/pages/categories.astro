---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList/index.astro';
import Title from '../components/Title/index.astro';
import VerticalSpace from '../components/VerticalSpace/index.astro';

import { getCollection } from 'astro:content';
import { title, description } from '../blog-config.js';
import _ from 'lodash';

// Load all posts
const allPosts = await getCollection('posts');

const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(post => {
    return {
      id: post.id,
      fields: { 
        slug: `/${post.id}/`, 
        readingTime: { minutes: Math.ceil((post.body || "").split(/\s+/).length / 200) }
      },
      excerpt: post.data.description || 'No excerpt available',
      frontmatter: {
        ...post.data,
        date: post.data.date instanceof Date ? post.data.date.toLocaleDateString('da-DK', { day: '2-digit', month: 'long', year: 'numeric' }) : post.data.date,
        update: post.data.update instanceof Date ? post.data.update.toLocaleDateString('da-DK', { day: '2-digit', month: 'long', year: 'numeric' }) : post.data.update,
        category: post.data.category,
        image: post.data.image ? { childImageSharp: { gatsbyImageData: { images: { fallback: { src: post.data.image.src } } } } } : null
      }
    };
  });

// Extract categories
const allCategories = posts.flatMap(post => post.frontmatter.category || []);
const categoryGroups = _.countBy(allCategories);
const categories = _.sortBy(
  Object.entries(categoryGroups).map(([fieldValue, totalCount]) => ({
    fieldValue,
    totalCount,
  })),
  ["totalCount"]
).reverse();

---

<Layout title={`Kategorier - ${title}`} description={description}>
  
  <div class="category-page">
    <Title size="sm">
      <span id="category-title">Der er {categories.length} kategorier 📦</span>
    </Title>

    <div class="category-cloud">
      {categories.map((cat) => (
        <a 
          href={`/categories?q=${cat.fieldValue}`} 
          class="category-pill" 
          data-category={cat.fieldValue}
        >
          {cat.fieldValue} ({cat.totalCount})
        </a>
      ))}
    </div>
  </div>

  <VerticalSpace size={32} />

  <div id="filtered-posts">
    <PostList postList={posts} />
  </div>

</Layout>

<script>
  // Simple client-side filtering for categories
  const urlParams = new URLSearchParams(window.location.search);
  const selectedCat = urlParams.get('q');
  const postItems = document.querySelectorAll('.post-item');
  const catTitle = document.getElementById('category-title');

  if (selectedCat) {
     if (catTitle) catTitle.textContent = `Matching category: ${selectedCat}`;
     
     postItems.forEach(item => {
        const categories = Array.from(item.querySelectorAll('.category-link')).map(a => (a.textContent || '').trim());
        if (categories.includes(selectedCat)) {
           (item as HTMLElement).style.display = 'block';
        } else {
           (item as HTMLElement).style.display = 'none';
        }
     });
  }
</script>

<style>
  .category-page {
    margin-top: 20px;
  }
  .category-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .category-pill {
    padding: 6px 12px;
    border-radius: 16px;
    background-color: var(--tagBackground);
    color: var(--bodyBackground);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s;
  }
  .category-pill:hover {
    background-color: var(--selectedTagBackground);
    color: var(--selectedTagText);
  }
</style>
